# Copy to .env.local and fill in GEMINI_API_KEY
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL_NEON=gemini-4-neon
GEMINI_MODEL_HYDROGEN=gemini-4-hydrogen
GEMINI_MODEL_NANO_BANANA=gemini-nano-banana-2.1
GEMINI_MODEL_DECISION=gemini-decision-1
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
SHOP_MCP_URL=https://mcp.shop.com/
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
